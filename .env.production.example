COPAZONE_TAG=prod

POSTGRES_DB=copazone
POSTGRES_USER=copazone
POSTGRES_PASSWORD=change-this-postgres-password

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432

HTTP_PORT=8081

APP_NAME=CopaZone
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8081
LOG_CHANNEL=stderr
LOG_LEVEL=info

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8081,localhost:8081
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=reverb

OPENLIGADB_BASE_URL=https://api.openligadb.de
OPENLIGADB_TIMEOUT=15
OPENLIGADB_CONNECT_TIMEOUT=5
OPENLIGADB_SOURCE_TIMEZONE=Europe/Berlin
APP_DISPLAY_TIMEZONE=America/Sao_Paulo
OPENLIGADB_WORLD_CUP_SHORTCUT=wm26
OPENLIGADB_WORLD_CUP_SEASON=2026
OPENLIGADB_DAILY_LIMIT=1000
OPENLIGADB_RESERVED_REQUESTS=100

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081

VITE_API_BASE_URL=
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http
